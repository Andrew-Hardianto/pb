    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "android:apk": "cd android && ./gradlew app:assembleRelease",
    "android:aab": "cd android && ./gradlew app:bundleRelease",
    "android:clean": "cd android && ./gradlew clean",
