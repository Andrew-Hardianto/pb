    "ios:build": "xed ios",
    "ios:archive": "xcodebuild -workspace ios/PacificBike.xcworkspace -scheme PacificBike -configuration Release archive -archivePath ios/build/PacificBike.xcarchive",
    "ios:clean": "xcodebuild -workspace ios/PacificBike.xcworkspace -scheme PacificBike clean"
  },
  "dependencies": {
