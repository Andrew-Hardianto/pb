{
  "name": "pb",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "reset-project": "node ./scripts/reset-project.js",
    "web": "expo start --web",
    "lint": "expo lint",
    "start": "npx expo start",
    "start:dev": "dotenv -e .env.development -- npx expo start",
    "start:prod": "dotenv -e .env.production -- npx expo start",
    "prebuild": "npx expo prebuild",
    "prebuild:clean": "npx expo prebuild --clean",
    "android": "npx expo run:android",
    "android:dev": "dotenv -e .env.development -- npx expo run:android",
    "android:prod": "dotenv -e .env.production -- npx expo run:android --variant release",
    "android:open": "cd android && ./gradlew tasks",
    "android:apk:prod": "dotenv -e .env.production -- npx expo prebuild --platform android && cd android && ./gradlew app:assembleRelease",
    "android:aab:prod": "dotenv -e .env.production -- npx expo prebuild --platform android && cd android && ./gradlew app:bundleRelease",
    "android:clean": "cd android && ./gradlew clean",
    "ios": "npx expo run:ios",
    "ios:dev": "dotenv -e .env.development -- npx expo run:ios",
    "ios:prod": "dotenv -e .env.production -- npx expo run:ios --configuration Release",
    "ios:pods": "cd ios && pod install",
    "ios:open": "open ios/PacificBike.xcworkspace",
    "ios:clean": "xcodebuild -workspace ios/PacificBike.xcworkspace -scheme PacificBike clean",
    "ios:archive:prod": "dotenv -e .env.production -- npx expo prebuild --platform ios && xcodebuild -workspace ios/PacificBike.xcworkspace -scheme PacificBike -configuration Release archive -archivePath ios/build/PacificBike.xcarchive",
    "ios:ipa:prod": "xcodebuild -exportArchive -archivePath ios/build/PacificBike.xcarchive -exportPath ios/build/production -exportOptionsPlist ios/ExportOptions.plist"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@tanstack/react-query": "^5.100.3",
    "axios": "^1.15.2",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "expo": "~55.0.15",
    "expo-constants": "~55.0.14",
    "expo-device": "~55.0.15",
    "expo-font": "~55.0.6",
    "expo-glass-effect": "~55.0.10",
    "expo-image": "~55.0.8",
    "expo-linking": "~55.0.13",
    "expo-local-authentication": "~55.0.15",
    "expo-router": "~55.0.12",
    "expo-splash-screen": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.15",
    "expo-web-browser": "~55.0.14",
    "jwt-decode": "^4.0.0",
    "react": "19.2.0",
    "react-content-loader": "^7.1.2",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.2.2",
    "dotenv-cli": "^11.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
